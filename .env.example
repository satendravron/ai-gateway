# Redis
REDIS_URL=redis://localhost:6379

# Postgres
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway

# Gateway
GATEWAY_PORT=4000
API_KEY_SALT=change-me-in-production

# API service
API_PORT=4001

# Mock providers (used when starting mock-providers app)
MOCK_A_PORT=3001
MOCK_B_PORT=3002
MOCK_C_PORT=3003

# Real provider keys (optional - leave blank to use mock only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Dashboard
VITE_WS_URL=ws://localhost:4001/ws
VITE_API_URL=http://localhost:4001
